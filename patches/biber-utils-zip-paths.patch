Read /zip paths through perl, not Win32::Unicode.

On Windows the five file subs take the Win32::Unicode branch whenever the
ANSI code page is not UTF-8. Win32::Unicode calls CreateFileW, which sees
only the real file system, while /zip is served by the VFS behind perl's
own win32_* I/O. Send /zip paths down the plain branch; real files keep
the Win32::Unicode path, so non-ASCII file names still work.

--- a/Biber/Utils.pm
+++ b/Biber/Utils.pm
@@ -171,7 +171,7 @@
   my ($filename, $encoding) = @_;
   my $slurp;
   $encoding //= 'UTF-8';
-  if ($^O =~ /Win/ and not is_Unicode_system() ) {
+  if ($^O =~ /Win/ and not is_Unicode_system() and $filename !~ m{^[/\\]zip[/\\]} ) {
     require Win32::Unicode::File;
     my $fh = Win32::Unicode::File->new('<', $filename);
     $fh->binmode(":encoding($encoding)");
@@ -195,7 +195,7 @@
 
 sub slurp_switchw {
   my ($filename, $string) = @_;
-  if ($^O =~ /Win/ and not is_Unicode_system() ) {
+  if ($^O =~ /Win/ and not is_Unicode_system() and $filename !~ m{^[/\\]zip[/\\]} ) {
     require Win32::Unicode::File;
     my $fh = Win32::Unicode::File->new('>', $filename);
     $fh->binmode(':encoding(UTF-8)');
@@ -391,7 +391,7 @@
 
 sub file_exist_check {
   my $filename = shift;
-  if ($^O =~ /Win/ and not is_Unicode_system() ) {
+  if ($^O =~ /Win/ and not is_Unicode_system() and $filename !~ m{^[/\\]zip[/\\]} ) {
     require Win32::Unicode::File;
     if (Win32::Unicode::File::statW($filename)) {
       return $filename;
@@ -426,7 +426,7 @@
 
 sub check_empty {
   my $filename = shift;
-  if ($^O =~ /Win/ and not is_Unicode_system() ) {
+  if ($^O =~ /Win/ and not is_Unicode_system() and $filename !~ m{^[/\\]zip[/\\]} ) {
     require Win32::Unicode::File;
     return (Win32::Unicode::File::file_size($filename)) ? 1 : 0;
   }
@@ -443,7 +443,7 @@
 
 sub check_exists {
   my $filename = shift;
-  if ($^O =~ /Win/ and not is_Unicode_system() ) {
+  if ($^O =~ /Win/ and not is_Unicode_system() and $filename !~ m{^[/\\]zip[/\\]} ) {
     require Win32::Unicode::File;
     return Win32::Unicode::File::statW($filename) ? 1 : 0;
   }
